GEMINI_API_KEY=tu-clave
FRED_API_KEY=tu-clave-de-fred
PPI_API_KEY=tu-clave-publica-de-ppi
PPI_API_SECRET=tu-clave-privada-de-ppi
GEMINI_MODEL=gemini-3.1-flash-lite
MAX_ITERACIONES=15
CONFIRMAR_CODIGO=true
GEMINI_MODELOS_RESPALDO=gemini-3.5-flash-lite,gemini-3.6-flash
# Contraseña del panel web: obligatoria antes de compartirlo con un túnel
PANEL_CLAVE=elegi-una-contraseña-larga
# Contraseña aparte para la sección Carteras del panel (si hay PANEL_CLAVE y falta esta, Carteras queda cerrada)
CARTERAS_CLAVE=otra-contraseña-distinta
